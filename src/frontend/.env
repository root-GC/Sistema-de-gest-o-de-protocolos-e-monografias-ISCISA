# Copiar para .env.local e ajustar
# Vazio = pedidos à mesma origem; o proxy do Vite encaminha /api para o backend.
VITE_API_URL=
VITE_API_KEY=your_api_key_here
VITE_API_SECRET=your_api_secret_here
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=5000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000
VITE_API_LOG_LEVEL=info
VITE_API_CACHE_ENABLED=true
VITE_API_CACHE_TTL=3600
VITE_API_RATE_LIMIT=100
VITE_API_RATE_LIMIT_WINDOW=60
VITE_API_CORS_ORIGIN=http://localhost:3000
VITE_API_CORS_METHODS=GET,POST,PUT,DELETE
VITE_API_CORS_HEADERS=Content-Type,Authorization
VITE_API_CORS_CREDENTIALS=true
VITE_API_CORS_MAX_AGE=3600
VITE_API_CORS_EXPOSE_HEADERS=Content-Length,Content-Type
VITE_API_CORS_OPTIONS_SUCCESS_STATUS=204
VITE_API_CORS_OPTIONS_FAILURE_STATUS=403
VITE_API_CORS_OPTIONS_TIMEOUT=5000
VITE_API_CORS_OPTIONS_RETRY_ATTEMPTS=3
VITE_API_CORS_OPTIONS_RETRY_DELAY=1000
VITE_API_CORS_OPTIONS_LOG_LEVEL=info
VITE_API_CORS_OPTIONS_CACHE_ENABLED=true
VITE_API_CORS_OPTIONS_CACHE_TTL=3600
VITE_API_CORS_OPTIONS_RATE_LIMIT=100
VITE_API_CORS_OPTIONS_RATE_LIMIT_WINDOW=60
VITE_API_CORS_OPTIONS_ORIGIN=http://localhost:3000
VITE_API_CORS_OPTIONS_METHODS=GET,POST,PUT,DELETE
VITE_API_CORS_OPTIONS_HEADERS=Content-Type,Authorization
VITE_API_CORS_OPTIONS_CREDENTIALS=true
